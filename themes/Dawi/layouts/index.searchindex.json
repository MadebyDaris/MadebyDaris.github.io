[
{{ $pages := where .Site.RegularPages "Type" "in" (slice "post" "project" "page") }}
{{ $pages = $pages | append (where .Site.RegularPages "Section" "renders") }}
{{ range $i, $p := $pages }}
{{ if $i }},{{ end }}
{
  "title": {{ $p.Title | jsonify }},
  "url": {{ $p.RelPermalink | jsonify }},
  "section": {{ $p.Section | jsonify }},
  "description": {{ ($p.Params.description | default $p.Summary | plainify | truncate 140) | jsonify }},
  "tags": {{ ($p.Params.tags | default (slice)) | jsonify }}
}
{{ end }}
]
